# Set only to verified, official destinations. Empty values show an honest availability dialog.
NEXT_PUBLIC_WEC_JOIN_URL=
NEXT_PUBLIC_WEC_EVENTS_URL=
# The club's Google Form PRE-FILLED link. Setting this turns on the in-site sign up form;
# answers land in the Form's Sheet. Steps: docs/GOOGLE-FORM.md. Redeploy after changing it.
NEXT_PUBLIC_WEC_GOOGLE_FORM_URL=
# Which emails the sign up form accepts. "western" (default): uwo.ca, huron/kings/brescia .uwo.ca,
# ivey.ca. "any": any email address. Nobody's email is verified either way.
NEXT_PUBLIC_WEC_EMAIL_RULE=western
# Optional fallback if the Google Form is not connected: an address the CLUB owns.
NEXT_PUBLIC_WEC_CONTACT_EMAIL=
# Optional verified public origin, used for canonical / Open Graph URLs.
NEXT_PUBLIC_SITE_URL=
# EXEC APPLICATIONS (the /apply/executives page, NOT the member sign up above).
# The club's exec applications Google Form PRE-FILLED link. SERVER SIDE ONLY: no NEXT_PUBLIC_
# prefix, never sent to a browser. Must be https://docs.google.com/... Until it is set, and the
# Form passes the setup check, the page says applications are not open. Steps:
# docs/EXEC-APPLICATIONS-FORM.md. Redeploy after changing it.
WEC_APPLY_GOOGLE_FORM_URL=
# Optional, recommended: any long random string. The password for the detailed setup check at
# /api/exec-applications?detail=1&key=... Unset, that check is refused in production.
WEC_SETUP_CHECK_KEY=
