-- Shared by every pgTAP file. Everything runs in a transaction that rolls back.
\set pres  'a0000000-0000-0000-0000-000000000001'
\set vpev  'a0000000-0000-0000-0000-000000000002'
\set vpco  'a0000000-0000-0000-0000-000000000003'
\set dirco 'a0000000-0000-0000-0000-000000000004'
\set vpou  'a0000000-0000-0000-0000-000000000005'
\set cdou  'a0000000-0000-0000-0000-000000000006'
\set vpfi  'a0000000-0000-0000-0000-000000000007'
\set dirfi 'a0000000-0000-0000-0000-000000000008'
\set adm   'a0000000-0000-0000-0000-000000000009'
\set frm   'a0000000-0000-0000-0000-00000000000a'
\set dirad 'a0000000-0000-0000-0000-00000000000b'
create extension if not exists pgtap with schema extensions;
set search_path = extensions, public;
create schema tests;
grant usage on schema tests to authenticated;
create function tests.login(p uuid) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', p, 'role', 'authenticated')::text, true);
  execute 'set local role authenticated';
end $$;
grant execute on function tests.login(uuid) to authenticated;
create function tests.dept(s text) returns uuid language sql stable security definer set search_path = '' as $$
  select id from os.departments where slug = s
$$;
grant execute on function tests.dept(text) to authenticated;
